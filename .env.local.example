# TMDb API Configuration
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Configuration (Optional)
NEXT_PUBLIC_OMDB_API_KEY=your_omdb_api_key_here

# Provider Configuration
NEXT_PUBLIC_PRIMARY_PROVIDER=tmdb
NEXT_PUBLIC_FALLBACK_PROVIDERS=tmdb,mock

# Feature Flags
NEXT_PUBLIC_ENABLE_TELEMETRY=false
NEXT_PUBLIC_ENABLE_DEBUG_TOOLS=false

# Cache Configuration
NEXT_PUBLIC_CACHE_MAX_SIZE=1000
NEXT_PUBLIC_CACHE_DEFAULT_STALE_TIME=300000

# Rate Limiting
NEXT_PUBLIC_RATE_LIMIT_CAPACITY=40
NEXT_PUBLIC_RATE_LIMIT_REFILL_RATE=10

# Circuit Breaker
NEXT_PUBLIC_CIRCUIT_BREAKER_THRESHOLD=5
NEXT_PUBLIC_CIRCUIT_BREAKER_TIMEOUT=60000

# Retry Configuration
NEXT_PUBLIC_MAX_RETRY_ATTEMPTS=3
NEXT_PUBLIC_RETRY_INITIAL_DELAY=1000
